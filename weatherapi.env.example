# Example development values only; production owner must approve limits and plan.
WEATHER_API_KEY=replace-with-server-secret
WEATHER_ACCOUNT=your-weatherapi-account-id
WEATHER_ALLOWED_HOSTS=api.weatherapi.com
IP_LIMIT=60
IP_WINDOW=60
QUOTA_LIMIT=1000
QUOTA_WINDOW=86400
WEATHER_DB=/absolute/path/to/weather.sqlite
BIND=127.0.0.1
PORT=8000
